        {
            "name": "(MSVC) Attach to process",
            "type": "cppvsdbg",
            "request": "attach",
            "processId": "${command:pickProcess}"
        }
    ],
    "inputs": [
        {
            "id": "msvcArch",
            "type": "pickString",
            "description": "MSVC architecture",
            "options": [
                "x64",
                "x86"
            ],
            "default": "x64"
        },
        {
            "id": "msvcConfig",
            "type": "pickString",
            "description": "MSVC configuration",
            "options": [
                "Debug",
                "Release",
                "RelWithDebInfo"
            ],
            "default": "Debug"
        },
        {
            "id": "mingwArch",
            "type": "pickString",
            "description": "MinGW architecture",
            "options": [
                "mingw-x64",
                "mingw-x86"
            ],
            "default": "mingw-x64"
        },
        {
            "id": "mingwConfig",
            "type": "pickString",
            "description": "MinGW configuration",
            "options": [
                "debug",
                "release",
                "relwithdebinfo"
            ],
            "default": "debug"
        },
        {
            "id": "mingwGdb",
            "type": "promptString",
            "description": "Path to gdb.exe from the MinGW toolchain",
            "default": "${env:MHOOK_MINGW_X64_ROOT}/bin/gdb.exe"
        },
        {
            "id": "hookCase",
            "type": "promptString",
            "description": "hook-test case name, for example basic or trampoline",
            "default": "basic"
        },
        {
            "id": "statusCase",
            "type": "promptString",
            "description": "status-test case name, for example initial or not_found",
            "default": "initial"
        }
    ]
}
