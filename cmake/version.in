#pragma once

/** Major version. Changes when the public interface breaks. */
#define MHOOK_VERSION_MAJOR @MHOOK_VERSION_MAJOR@

/** Minor version. Changes when the public interface grows compatibly. */
#define MHOOK_VERSION_MINOR @MHOOK_VERSION_MINOR@

/** Patch version. Changes for fixes that do not touch the interface. */
#define MHOOK_VERSION_PATCH @MHOOK_VERSION_PATCH@

/** Full version as a string literal, for example "3.0.0". */
#define MHOOK_VERSION_STRING "@MHOOK_VERSION@"
