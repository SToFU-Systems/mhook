# EditorConfig - https://editorconfig.org
# Top-most config; stop searching parent directories.
root = true

# Defaults for every file.
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# C/C++ and header templates - aligned with .clang-format
# (IndentWidth 4, ColumnLimit 120).
[*.{c,cc,cxx,cpp,h,hh,hpp,in}]
max_line_length = 120

# CMake.
[{CMakeLists.txt,*.cmake}]
indent_size = 4

# Python.
[*.py]
indent_size = 4

# JSON (CMakePresets.json, etc.).
[*.json]
indent_size = 4

# YAML.
[*.{yml,yaml}]
indent_size = 2

# Windows scripts must keep CRLF line endings.
[*.{bat,cmd}]
end_of_line = crlf

# Markdown - trailing whitespace is significant (hard line breaks).
[*.md]
trim_trailing_whitespace = false
