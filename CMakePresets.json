{
  "version": 5,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "msvc",
      "hidden": true,
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "BUILD_TESTING": true,
        "MHOOK_BUILD_EXAMPLES": true,
        "MHOOK_ENABLE_SANITY_CHECKS": true
      }
    },
    {
      "name": "msvc-x86",
      "displayName": "MSVC x86",
      "inherits": "msvc",
      "architecture": "Win32"
    },
    {
      "name": "msvc-x64",
      "displayName": "MSVC x64",
      "inherits": "msvc",
      "architecture": "x64"
    },
    {
      "name": "mingw",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "BUILD_TESTING": true,
        "MHOOK_BUILD_EXAMPLES": true,
        "MHOOK_ENABLE_SANITY_CHECKS": true
      }
    },
    {
      "name": "mingw-x86-debug",
      "displayName": "MinGW x86 Debug (experimental)",
      "inherits": "mingw",
      "condition": {
        "type": "allOf",
        "conditions": [
          {
            "type": "equals",
            "lhs": "${hostSystemName}",
            "rhs": "Windows"
          },
          {
            "type": "notEquals",
            "lhs": "$env{MHOOK_MINGW_X86_ROOT}",
            "rhs": ""
          }
        ]
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "$env{MHOOK_MINGW_X86_ROOT}/bin/gcc.exe",
        "CMAKE_CXX_COMPILER": "$env{MHOOK_MINGW_X86_ROOT}/bin/g++.exe",
        "MHOOK_EXPECTED_ARCHITECTURE": "x86"
      },
      "environment": {
        "PATH": "$env{MHOOK_MINGW_X86_ROOT}/bin;$penv{PATH}"
      }
    },
    {
      "name": "mingw-x86-release",
      "displayName": "MinGW x86 Release (experimental)",
      "inherits": "mingw",
      "condition": {
        "type": "allOf",
        "conditions": [
          {
            "type": "equals",
            "lhs": "${hostSystemName}",
            "rhs": "Windows"
          },
          {
            "type": "notEquals",
            "lhs": "$env{MHOOK_MINGW_X86_ROOT}",
            "rhs": ""
          }
        ]
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "$env{MHOOK_MINGW_X86_ROOT}/bin/gcc.exe",
        "CMAKE_CXX_COMPILER": "$env{MHOOK_MINGW_X86_ROOT}/bin/g++.exe",
        "MHOOK_EXPECTED_ARCHITECTURE": "x86"
      },
      "environment": {
        "PATH": "$env{MHOOK_MINGW_X86_ROOT}/bin;$penv{PATH}"
      }
    },
    {
      "name": "mingw-x64-debug",
      "displayName": "MinGW x64 Debug (experimental)",
      "inherits": "mingw",
      "condition": {
        "type": "allOf",
        "conditions": [
          {
            "type": "equals",
            "lhs": "${hostSystemName}",
            "rhs": "Windows"
          },
          {
            "type": "notEquals",
            "lhs": "$env{MHOOK_MINGW_X64_ROOT}",
            "rhs": ""
          }
        ]
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "$env{MHOOK_MINGW_X64_ROOT}/bin/gcc.exe",
        "CMAKE_CXX_COMPILER": "$env{MHOOK_MINGW_X64_ROOT}/bin/g++.exe",
        "MHOOK_EXPECTED_ARCHITECTURE": "x64"
      },
      "environment": {
        "PATH": "$env{MHOOK_MINGW_X64_ROOT}/bin;$penv{PATH}"
      }
    },
    {
      "name": "mingw-x64-release",
      "displayName": "MinGW x64 Release (experimental)",
      "inherits": "mingw",
      "condition": {
        "type": "allOf",
        "conditions": [
          {
            "type": "equals",
            "lhs": "${hostSystemName}",
            "rhs": "Windows"
          },
          {
            "type": "notEquals",
            "lhs": "$env{MHOOK_MINGW_X64_ROOT}",
            "rhs": ""
          }
        ]
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "$env{MHOOK_MINGW_X64_ROOT}/bin/gcc.exe",
        "CMAKE_CXX_COMPILER": "$env{MHOOK_MINGW_X64_ROOT}/bin/g++.exe",
        "MHOOK_EXPECTED_ARCHITECTURE": "x64"
      },
      "environment": {
        "PATH": "$env{MHOOK_MINGW_X64_ROOT}/bin;$penv{PATH}"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "msvc-x86-debug",
      "configurePreset": "msvc-x86",
      "configuration": "Debug"
    },
    {
      "name": "mingw-x86-debug",
      "configurePreset": "mingw-x86-debug"
    },
    {
      "name": "msvc-x86-release",
      "configurePreset": "msvc-x86",
      "configuration": "Release"
    },
    {
      "name": "mingw-x86-release",
      "configurePreset": "mingw-x86-release"
    },
    {
      "name": "msvc-x64-debug",
      "configurePreset": "msvc-x64",
      "configuration": "Debug"
    },
    {
      "name": "mingw-x64-debug",
      "configurePreset": "mingw-x64-debug"
    },
    {
      "name": "msvc-x64-release",
      "configurePreset": "msvc-x64",
      "configuration": "Release"
    },
    {
      "name": "mingw-x64-release",
      "configurePreset": "mingw-x64-release"
    }
  ],
  "testPresets": [
    {
      "name": "msvc-x86-debug",
      "configurePreset": "msvc-x86",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "mingw-x86-debug",
      "configurePreset": "mingw-x86-debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "msvc-x86-release",
      "configurePreset": "msvc-x86",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "mingw-x86-release",
      "configurePreset": "mingw-x86-release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "msvc-x64-debug",
      "configurePreset": "msvc-x64",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "mingw-x64-debug",
      "configurePreset": "mingw-x64-debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "msvc-x64-release",
      "configurePreset": "msvc-x64",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "mingw-x64-release",
      "configurePreset": "mingw-x64-release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
